{
  "name": "kipuray-web",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && node build-recorder.mjs",
    "check": "tsc -b && prettier --check src tests *.ts *.json *.mjs *.html ../internal/demo/*.html ../internal/report/*.html ../scripts/*.mjs",
    "format": "prettier --write src tests *.ts *.json *.mjs *.html ../internal/demo/*.html ../internal/report/*.html ../scripts/*.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rrweb": "^2.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
